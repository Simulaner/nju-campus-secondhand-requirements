@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #63527B
skinparam classBackgroundColor #F7F4FC
skinparam classBorderColor #B3A3CB
skinparam componentBackgroundColor #F7F4FC
skinparam componentBorderColor #B3A3CB
skinparam stateBackgroundColor #F7F4FC
skinparam stateBorderColor #B3A3CB
skinparam activityBackgroundColor #F7F4FC
skinparam activityBorderColor #B3A3CB
skinparam sequenceParticipantBackgroundColor #F7F4FC
skinparam sequenceLifeLineBorderColor #C4BBCF
skinparam NoteBackgroundColor #FFF8E7
skinparam NoteBorderColor #D9C69A
skinparam titleFontSize 22
hide empty members
title 栖物 · 从发布到交易完成
|卖家|
start
:保存商品草稿;
:完善信息并提交审核;
|管理员|
while (审核通过?) is (否)
  :记录驳回原因;
  |卖家|
  :根据原因修改并重新提交;
  |管理员|
endwhile (是)
:公开发布商品;
|买家|
:搜索并查看商品;
:提交预约;
|系统|
if (实时状态和权限有效，且竞争成功?) then (是)
  :同事务创建预约并占用商品;
else (否)
  :显示最新状态或明确错误;
  stop
endif
|卖家|
if (24小时内接受预约?) then (是)
  :接受预约;
  |买家|
  :双方通过授权联系方式约定面交;
  :线下交接;
  |系统|
  :分别接收买家收货与卖家完成确认;
  if (过程中取消或下架?) then (是)
    :取消预约；按下架状态决定是否释放商品;
    :保存通知与日志;
    stop
  endif
  while (双方确认是否齐全?) is (否)
    :保留已确认标记；等待另一方或取消;
    if (收到取消/下架?) then (是)
      :原子取消；清理占用与联系信息;
      stop
    endif
  endwhile (是)
  :同事务完成预约、生成唯一交易、商品已售出;
  :保存日志并清理联系信息;
  stop
else (拒绝 / 取消 / 到期 / 下架)
  |系统|
  :按实际事件关闭预约;
  :仅当商品仍处于可释放占用时恢复已发布;
  :保存通知及成功/失败日志;
  stop
endif

@enduml
